.env
credentials.json
token.json
__pycache__/
*.pyc
output/
logs/
# Intermedios generados por cada run (regenerados siempre; NO versionar).
# Se conservan los PNG de referencia en la raíz de images/.
images/*/
# Excepción: las poses de los personajes SÍ se versionan (las usa el runner).
!images/personajes/
!images/personajes/**
audio/
videos/
tmp/*.mp3
tmp/*.wav
tmp/*.mp4
*.mp4
*.wav
*.mp3
!assets/music/**/*.mp3
!assets/music/*.mp3
.claude/

# Footage temático CC (se re-baja)
footage_cc/

# Pack de SFX del motor de video (excepción al *.wav de arriba)
!modules/pack_sfx/
!modules/pack_sfx/*.wav
